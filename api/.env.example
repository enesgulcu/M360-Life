# Neon pooled connection string (Vercel env + yerel)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Oyun / dedicated sunucu paylasimli anahtar (set edilirse /api/jobs zorunlu header)
# Header: X-M360-Server-Key
# M360_SERVER_KEY=

# Dakikada IP basina istek limiti (varsayilan 60)
# M360_RATE_LIMIT_DAKIKA=60
